{
  "name": "carcare-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-fr-registry-prod.mjs && tsc -b && vite build && node scripts/emit-404-html.mjs && node scripts/merge-fr-sitemap.mjs && node scripts/build-fr-prod-ssg.mjs",
    "build:fr-preview": "node scripts/build-fr-preview.mjs",
    "build:fr-poc": "npm run build:fr-preview",
    "validate:fr-poc": "node scripts/validate-fr-poc.mjs",
    "validate:fr-prod-routing": "node scripts/validate-fr-prod-routing.mjs",
    "validate:fr-stage1": "node scripts/validate-fr-stage1.mjs",
    "validate:fr-prod-ssg": "node scripts/validate-fr-prod-ssg.mjs",
    "validate:fr-stage2": "node scripts/validate-fr-stage2.mjs",
    "validate:fr-sitemap": "node scripts/validate-fr-sitemap.mjs",
    "validate:fr-stage3": "node scripts/validate-fr-stage3.mjs",
    "audit:fr-preview-html": "node scripts/audit-fr-preview-html.mjs",
    "preview:fr": "vite preview --outDir dist-fr-preview --strictPort --port 5190",
    "check:qr": "node scripts/check-fleet-qr.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.469.0",
    "posthog-js": "^1.438.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "supabase": "^2.84.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  }
